# =========================================================================
# 宿舍共好 — 室友公約與噪音管理系統 環境變數範本文件 (.env.example)
# 請複製此檔案並重新命名為 .env，並將各項設定修改為適合您開發環境的數值
# =========================================================================

# Flask 全域配置
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True

# 安全金鑰 (請更改為高強度隨機字串，例如使用 os.urandom(24))
SECRET_KEY=roommate_cooperation_super_secret_key_2026_dev_only

# 資料庫連線配置
# SQLite 資料庫預設儲存於 instance/database.db
DATABASE_URL=sqlite:///instance/database.db

# 伺服器啟動配置
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
